# Docker local development uses .env.docker.
# Vercel production/preview should use Supabase project environment variables.

# Runtime connection string. For Supabase on Vercel, prefer the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection string for Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

